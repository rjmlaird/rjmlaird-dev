---
import nav from "../data/nav.json";
---

<nav class="site-nav" aria-label="Primary">
  <a href="/" class="logo">RJM<span>L</span></a>

  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="primary-menu"
  >
    <span class="sr-only">Toggle navigation</span>
    <span aria-hidden="true" class="hamburger">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>

  <div class="nav-panel" id="primary-menu">
    <ul class="nl">
      {
        nav.map((item) => (
          <li>
            <a href={`/${item.id}`}>{item.label}</a>
          </li>
        ))
      }
    </ul>

    <div class="nr">
      <a href="https://cv.rjmlaird.co.uk" class="nsub">Full CV ↗</a>
      <a href="mailto:ryan@rjmlaird.co.uk" class="ncta">Get in touch</a>
    </div>
  </div>
</nav>

<script>
  const navEl = document.querySelector(".site-nav");
  const toggle = document.querySelector(".nav-toggle");
  const panel = document.querySelector("#primary-menu");

  const closeMenu = () => {
    navEl?.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
  };

  toggle?.addEventListener("click", () => {
    const isOpen = navEl?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (navEl && target instanceof Node && !navEl.contains(target)) closeMenu();
  });
</script>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    position: relative;
    padding: 1rem 0;
  }

  .logo {
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.03em;
    font-size: 1.1rem;
    flex: 0 0 auto;
  }

  .logo span {
    opacity: 0.65;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 0.75rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .hamburger {
    display: grid;
    gap: 0.28rem;
  }

  .hamburger span {
    display: block;
    width: 1.2rem;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
  }

  .nav-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex: 1;
  }

  .nl,
  .nr {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nl a,
  .nr a {
    text-decoration: none;
    font-weight: 500;
  }

  .ncta {
    padding: 0.7rem 1rem;
    border-radius: 999px;
    background: currentColor;
    color: white;
  }

  .nsub {
    opacity: 0.8;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 820px) {
    .site-nav {
      flex-wrap: wrap;
    }

    .nav-toggle {
      display: inline-flex;
      margin-left: auto;
    }

    .nav-panel {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1rem 0 0;
    }

    .site-nav.is-open .nav-panel {
      display: flex;
    }

    .nl,
    .nr {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }

    .nl a,
    .nr a {
      display: block;
      padding: 0.85rem 0.95rem;
      border-radius: 0.85rem;
      background: color-mix(in srgb, currentColor 4%, transparent);
    }

    .ncta {
      text-align: center;
    }
  }
</style>
