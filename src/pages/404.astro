---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="That page does not exist on the developer hub.">
  <div class="wrap page">
    <header class="page-head">
      <p class="sl">404</p>
      <h1>Nothing at this address</h1>
      <p class="lead">The page may have moved, or the link may be wrong. Try one of these instead.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn" href="/projects/">Projects</a>
        <a class="btn" href="/open-source/">Open source</a>
        <a class="btn" href="/stack/">Stack</a>
      </div>
    </header>
  </div>
</Layout>
