---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Ryan Laird | Digital Developer">
  <Nav />

  <main class="home">
    <section id="hero" class="hero container">
      <p class="eyebrow">Digital developer · science communicator</p>
      <h1>Building accessible, data-driven web experiences.</h1>
      <p class="lede">
        I design and develop Astro and React sites, shape structured content
        systems, and build clear digital experiences that are easy to use and
        maintain.
      </p>

      <div class="cta-row">
        <a class="btn primary" href="/projects/">View projects</a>
        <a class="btn secondary" href="/about/">About me</a>
        <a class="btn secondary" href="/open-source/">Open source</a>
        <a class="btn secondary" href="/contact/">Contact</a>
      </div>
    </section>

    <section class="section container">
      <h2>What I do</h2>
      <div class="grid-3">
        <article class="panel">
          <h3>Web development</h3>
          <p>
            Astro, React, TypeScript, content modelling, component systems, and
            performance-aware front-end builds.
          </p>
        </article>

        <article class="panel">
          <h3>Science communication</h3>
          <p>
            Space, climate, and technical topics presented with structure,
            clarity, and accessibility in mind.
          </p>
        </article>

        <article class="panel">
          <h3>Automation</h3>
          <p>
            Scripts, APIs, and workflows that reduce friction across publishing,
            research, and digital asset management.
          </p>
        </article>
      </div>
    </section>

    <section class="section container">
      <h2>Featured areas</h2>
      <div class="grid-2">
        <a class="feature-card" href="/projects/">
          <span class="feature-kicker">Projects</span>
          <strong>Curated work and case studies.</strong>
          <p>Selected builds, portfolio highlights, and ongoing experiments.</p>
        </a>

        <a class="feature-card" href="/open-source/">
          <span class="feature-kicker">Open source</span>
          <strong>Live GitHub data and activity.</strong>
          <p>Repos, languages, organisations, and contribution context.</p>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .home {
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .hero {
    display: grid;
    gap: 1rem;
    padding-block-end: 2rem;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    opacity: 0.72;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 0.98;
    max-width: 12ch;
  }

  .lede {
    margin: 0;
    max-width: 68ch;
    font-size: 1.08rem;
    line-height: 1.7;
    opacity: 0.92;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
  }

  .btn.primary {
    background: currentColor;
    color: white;
  }

  .btn.secondary {
    background: transparent;
  }

  .section {
    padding-block: 1.5rem;
  }

  .grid-3,
  .grid-2 {
    display: grid;
    gap: 1rem;
  }

  .grid-3 {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .grid-2 {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .panel,
  .feature-card {
    padding: 1.15rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    background: color-mix(in srgb, currentColor 3%, transparent);
  }

  .panel h3,
  .feature-card strong {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 1.05rem;
  }

  .panel p,
  .feature-card p {
    margin: 0;
    line-height: 1.65;
  }

  .feature-card {
    text-decoration: none;
    color: inherit;
  }

  .feature-kicker {
    display: inline-block;
    margin-bottom: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
    opacity: 0.7;
  }
</style>
