---
import Layout from "../layouts/Layout.astro";

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;
const GITHUB_USERNAME = "rjmlaird";
const PROJECT_NUMBER = 1;

const query = `
  query($login: String!, $number: Int!) {
    user(login: $login) {
      projectV2(number: $number) {
        title
        shortDescription
        url
        fields(first: 20) {
          nodes {
            ... on ProjectV2FieldCommon {
              name
            }
          }
        }
        items(first: 10) {
          nodes {
            content {
              ... on Issue {
                title
                url
              }
              ... on PullRequest {
                title
                url
              }
            }
          }
        }
      }
    }
  }
`;

const response = await fetch("https://api.github.com/graphql", {
  method: "POST",
  headers: {
    Authorization: `Bearer ${GITHUB_TOKEN}`,
    "Content-Type": "application/json",
  },
  body: JSON.stringify({
    query,
    variables: {
      login: GITHUB_USERNAME,
      number: PROJECT_NUMBER,
    },
  }),
});

const json = await response.json();
const project = json?.data?.user?.projectV2 ?? null;

const items = (project?.items?.nodes ?? [])
  .map((node) => node?.content)
  .filter(Boolean);
---

<Layout title="Projects">
  <section class="section-tight">
    <p class="eyebrow">Projects</p>
    <h1>Selected work and current focus</h1>
    <p class="lede">
      A mix of active projects, open source tools, experiments, and client work — with the latest status
      pulled from GitHub Projects where available.
    </p>
  </section>

  <section class="section-tight">
    <p class="eyebrow">Current board</p>
    <h2>{project ? project.title : "GitHub Project not available"}</h2>
    {project && <p class="body-text">{project.shortDescription}</p>}

    {project ? (
      <div class="card" style="margin-top:1.5rem;">
        <p><strong>Board:</strong> <a href={project.url} target="_blank" rel="noreferrer">Open in GitHub</a></p>
        <p style="margin-top:.75rem;"><strong>Items:</strong></p>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:.5rem;margin-top:.75rem;">
          {items.length > 0 ? items.map((item) => (
            <li style="color:var(--m);">
              <a href={item.url} target="_blank" rel="noreferrer">{item.title}</a>
            </li>
          )) : <li style="color:var(--m);">No items available right now.</li>}
        </ul>
      </div>
    ) : (
      <p class="body-text" style="margin-top:1rem;">
        The project board couldn’t be loaded at build time, so this page can still fall back to a curated list below.
      </p>
    )}
  </section>

  <section class="section-tight">
    <p class="eyebrow">Open source</p>
    <h2>Tools and repositories</h2>
    <div class="grid-3" style="margin-top:2rem;">
      <article class="card">
        <h3>Astro site components</h3>
        <p>Layouts, themes, and UI patterns used across this site.</p>
      </article>
      <article class="card">
        <h3>Data utilities</h3>
        <p>Scripts for fetching, cleaning, and visualising technical and geospatial data.</p>
      </article>
      <article class="card">
        <h3>Open source experiments</h3>
        <p>Small tools and prototypes that explore workflow automation and interface design.</p>
      </article>
    </div>
  </section>

  <section class="section-tight">
    <div class="cta-band">
      <h2>Want the full picture?</h2>
      <p class="lede">See the live GitHub board, browse repositories, or get in touch about collaboration.</p>
      <div class="hero-actions">
        <a href="https://github.com/rjmlaird" class="btn-cta" target="_blank" rel="noreferrer">View GitHub</a>
        <a href="/contact" class="btn-outline">Contact me</a>
      </div>
    </div>
  </section>
</Layout>
