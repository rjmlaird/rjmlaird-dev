---
import Layout from "../layouts/Layout.astro";

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;
const GITHUB_USERNAME = "rjmlaird";
const ORG_LOGIN = "YOUR_ORG";
const USER_PROJECT_NUMBER = 1;
const ORG_PROJECT_NUMBER = 1;

const query = `
  query(
    $login: String!
    $number: Int!
    $repoFirst: Int!
    $orgLogin: String!
    $orgProjectNumber: Int!
  ) {
    user(login: $login) {
      projectV2(number: $number) {
        title
        shortDescription
        url
        items(first: 10) {
          nodes {
            content {
              __typename
              ... on Issue {
                title
                url
              }
              ... on PullRequest {
                title
                url
              }
              ... on DraftIssue {
                title
              }
            }
          }
        }
      }
      repositories(first: $repoFirst, privacy: PUBLIC, orderBy: { field: PUSHED_AT, direction: DESC }) {
        nodes {
          name
          nameWithOwner
          description
          url
          homepageUrl
          isFork
          stargazerCount
          primaryLanguage {
            name
          }
        }
      }
    }
    organization(login: $orgLogin) {
      projectV2(number: $orgProjectNumber) {
        title
        shortDescription
        url
        items(first: 10) {
          nodes {
            content {
              __typename
              ... on Issue {
                title
                url
              }
              ... on PullRequest {
                title
                url
              }
              ... on DraftIssue {
                title
              }
            }
          }
        }
      }
      repositories(first: $repoFirst, privacy: PUBLIC, orderBy: { field: PUSHED_AT, direction: DESC }) {
        nodes {
          name
          nameWithOwner
          description
          url
          homepageUrl
          isFork
          stargazerCount
          primaryLanguage {
            name
          }
        }
      }
    }
  }
`;

let userProject = null;
let userItems = [];
let userRepositories = [];
let orgProject = null;
let orgItems = [];
let orgRepositories = [];
let projectError = null;

if (GITHUB_TOKEN) {
  try {
    const response = await fetch("https://api.github.com/graphql", {
      method: "POST",
      headers: {
        Authorization: `Bearer ${GITHUB_TOKEN}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        query,
        variables: {
          login: GITHUB_USERNAME,
          number: USER_PROJECT_NUMBER,
          repoFirst: 12,
          orgLogin: ORG_LOGIN,
          orgProjectNumber: ORG_PROJECT_NUMBER,
        },
      }),
    });

    const json = await response.json();

    if (json?.errors?.length) {
      projectError = json.errors[0].message ?? "GitHub GraphQL query failed.";
    } else {
      userProject = json?.data?.user?.projectV2 ?? null;
      userItems = (userProject?.items?.nodes ?? [])
        .map((node) => node?.content)
        .filter(Boolean);

      userRepositories = (json?.data?.user?.repositories?.nodes ?? []).filter(
        (repo) => repo && !repo.isFork
      );

      orgProject = json?.data?.organization?.projectV2 ?? null;
      orgItems = (orgProject?.items?.nodes ?? [])
        .map((node) => node?.content)
        .filter(Boolean);

      orgRepositories = (json?.data?.organization?.repositories?.nodes ?? []).filter(
        (repo) => repo && !repo.isFork
      );
    }
  } catch (err) {
    projectError = err instanceof Error ? err.message : "Unable to load project data.";
  }
} else {
  projectError = "Missing GITHUB_TOKEN.";
}
---

<Layout title="Projects">
  <section class="section-tight">
    <p class="eyebrow">Projects</p>
    <h1>Selected work and current focus</h1>
    <p class="lede">
      A mix of active projects, open source tools, experiments, and client work — with live data
      from GitHub where available.
    </p>
  </section>

  <section class="section-tight">
    <p class="eyebrow">Personal board</p>
    <h2>{userProject ? userProject.title : "GitHub Project not available"}</h2>
    {userProject?.shortDescription && <p class="body-text">{userProject.shortDescription}</p>}
    {userProject && (
      <div class="card" style="margin-top:1.5rem;">
        <p><strong>Board:</strong> <a href={userProject.url} target="_blank" rel="noreferrer">Open in GitHub</a></p>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:.5rem;margin-top:.75rem;">
          {userItems.map((item) => (
            <li style="color:var(--m);">
              {item?.url ? (
                <a href={item.url} target="_blank" rel="noreferrer">{item?.title ?? "Untitled item"}</a>
              ) : (
                item?.title ?? "Untitled item"
              )}
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <section class="section-tight">
    <p class="eyebrow">Organisation board</p>
    <h2>{orgProject ? orgProject.title : "Organisation project not available"}</h2>
    {orgProject?.shortDescription && <p class="body-text">{orgProject.shortDescription}</p>}
    {orgProject && (
      <div class="card" style="margin-top:1.5rem;">
        <p><strong>Board:</strong> <a href={orgProject.url} target="_blank" rel="noreferrer">Open in GitHub</a></p>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:.5rem;margin-top:.75rem;">
          {orgItems.map((item) => (
            <li style="color:var(--m);">
              {item?.url ? (
                <a href={item.url} target="_blank" rel="noreferrer">{item?.title ?? "Untitled item"}</a>
              ) : (
                item?.title ?? "Untitled item"
              )}
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <section class="section-tight">
    <p class="eyebrow">Open source</p>
    <h2>Public repositories</h2>

    <h3 style="margin-top:1rem;">Personal repositories</h3>
    <div class="grid-3" style="margin-top:1rem;">
      {userRepositories.map((repo) => (
        <article class="card">
          <h3>{repo.name}</h3>
          {repo.description ? <p>{repo.description}</p> : <p>No description provided.</p>}
          <a href={repo.url} class="card-link" target="_blank" rel="noreferrer">Repo →</a>
        </article>
      ))}
    </div>

    <h3 style="margin-top:2rem;">Organisation repositories</h3>
    <div class="grid-3" style="margin-top:1rem;">
      {orgRepositories.map((repo) => (
        <article class="card">
          <h3>{repo.name}</h3>
          {repo.description ? <p>{repo.description}</p> : <p>No description provided.</p>}
          <a href={repo.url} class="card-link" target="_blank" rel="noreferrer">Repo →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section-tight">
    <div class="cta-band">
      <h2>Want the full picture?</h2>
      <p class="lede">
        See the live GitHub boards, browse repositories, or get in touch about collaboration.
      </p>
      <div class="hero-actions">
        <a href="https://github.com/rjmlaird" class="btn-cta" target="_blank" rel="noreferrer">View GitHub</a>
        <a href="/contact" class="btn-outline">Contact me</a>
      </div>
    </div>
  </section>
</Layout>
