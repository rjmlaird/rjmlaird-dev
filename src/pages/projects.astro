---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectsCard.astro";

const DEV_TOKEN = import.meta.env.DEV_TOKEN;
const GITHUB_USERNAME = "rjmlaird";
const ORG_LOGIN = "greenorbitspace";
const USER_PROJECT_NUMBER = 1;
const ORG_PROJECT_NUMBER = 1;
const REPO_FIRST = 12;

const query = `
  query(
    $login: String!
    $number: Int!
    $repoFirst: Int!
    $orgLogin: String!
    $orgProjectNumber: Int!
  ) {
    user(login: $login) {
      projectV2(number: $number) {
        title
        shortDescription
        url
        repositories(first: 20) {
          nodes {
            nameWithOwner
            url
          }
        }
        items(first: 10) {
          nodes {
            content {
              __typename
              ... on Issue {
                title
                url
              }
              ... on PullRequest {
                title
                url
              }
              ... on DraftIssue {
                title
              }
            }
          }
        }
      }
      repositories(first: $repoFirst, privacy: PUBLIC, orderBy: { field: PUSHED_AT, direction: DESC }) {
        nodes {
          name
          nameWithOwner
          description
          url
          homepageUrl
          isFork
          stargazerCount
          primaryLanguage {
            name
          }
        }
      }
    }
    organization(login: $orgLogin) {
      projectV2(number: $orgProjectNumber) {
        title
        shortDescription
        url
        repositories(first: 20) {
          nodes {
            nameWithOwner
            url
          }
        }
        items(first: 10) {
          nodes {
            content {
              __typename
              ... on Issue {
                title
                url
              }
              ... on PullRequest {
                title
                url
              }
              ... on DraftIssue {
                title
              }
            }
          }
        }
      }
    }
  }
`;

let userProject = null;
let orgProject = null;
let projectError = null;
let cards = [];

if (DEV_TOKEN) {
  try {
    const response = await fetch("https://api.github.com/graphql", {
      method: "POST",
      headers: {
        Authorization: `Bearer ${DEV_TOKEN}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        query,
        variables: {
          login: GITHUB_USERNAME,
          number: USER_PROJECT_NUMBER,
          repoFirst: REPO_FIRST,
          orgLogin: ORG_LOGIN,
          orgProjectNumber: ORG_PROJECT_NUMBER,
        },
      }),
    });

    const json = await response.json();

    if (json?.errors?.length) {
      projectError = json.errors[0].message ?? "GitHub GraphQL query failed.";
    } else {
      userProject = json?.data?.user?.projectV2 ?? null;
      orgProject = json?.data?.organization?.projectV2 ?? null;

      const userItems = (userProject?.items?.nodes ?? [])
        .map((node) => node?.content)
        .filter(Boolean);

      const orgItems = (orgProject?.items?.nodes ?? [])
        .map((node) => node?.content)
        .filter(Boolean);

      const userRepos = (json?.data?.user?.repositories?.nodes ?? []).filter(
        (repo) => repo && !repo.isFork
      );

      cards = [
        ...(userProject
          ? [
              {
                id: 1,
                title: userProject.title,
                excerpt: userProject.shortDescription,
                topics: ["Personal board"],
                features: userProject.repositories?.nodes?.map((r) => r.nameWithOwner) ?? [],
                url: userProject.url,
                outcome: userItems.length ? `${userItems.length} items` : "No items",
                variant: "teal",
              },
            ]
          : []),
        ...(orgProject
          ? [
              {
                id: 2,
                title: orgProject.title,
                excerpt: orgProject.shortDescription,
                topics: ["Organisation board"],
                features: orgProject.repositories?.nodes?.map((r) => r.nameWithOwner) ?? [],
                url: orgProject.url,
                outcome: orgItems.length ? `${orgItems.length} items` : "No items",
                variant: "violet",
              },
            ]
          : []),
        ...userRepos.map((repo, index) => ({
          id: index + 3,
          title: repo.name,
          excerpt: repo.description ?? "",
          topics: [repo.primaryLanguage?.name ?? "Code"],
          features: repo.isFork ? ["Fork"] : [],
          url: repo.homepageUrl || repo.url,
          outcome: `${repo.stargazerCount} stars`,
          variant: "coral",
        })),
      ];
    }
  } catch (err) {
    projectError = err instanceof Error ? err.message : "Unable to load project data.";
  }
} else {
  projectError = "Missing DEV_TOKEN.";
}
---

<Layout title="Projects">
  <section class="section-tight">
    <p class="eyebrow">Projects</p>
    <h1>Selected work and current focus</h1>
    <p class="lede">
      A mix of active projects, open source tools, experiments, and client work — with live data
      from GitHub where available.
    </p>
  </section>

  {projectError ? (
    <section class="section-tight">
      <div class="card">
        <p class="body-text">{projectError}</p>
      </div>
    </section>
  ) : null}

  <section class="section-tight">
    <div class="grid-3">
      {cards.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <section class="section-tight">
    <div class="cta-band">
      <h2>Want the full picture?</h2>
      <p class="lede">
        See the live GitHub boards, browse repositories, or get in touch about collaboration.
      </p>
      <div class="hero-actions">
        <a href="https://github.com/rjmlaird" class="btn-cta" target="_blank" rel="noreferrer">View GitHub</a>
        <a href="/contact" class="btn-outline">Contact me</a>
      </div>
    </div>
  </section>
</Layout>
