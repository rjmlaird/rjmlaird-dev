---
import Layout from "../layouts/Layout.astro";

import {
  getGithubProfile,
  getGithubRepos,
  getGithubOrgRepos,
  getGithubOrgs,
  getGithubActivity,
  aggregateLanguages,
  getLanguageColor,
  GITHUB_USERNAME,
  usedSnapshot,
  snapshotDate,
} from "../lib/github";
import { SITE } from "../site";

const [profile, ownRepos, orgRepos, orgs, activity] = await Promise.all([
  getGithubProfile(),
  getGithubRepos(),
  getGithubOrgRepos(),
  getGithubOrgs(),
  getGithubActivity(),
]);

const allRepos = [...ownRepos, ...orgRepos];
const languages = aggregateLanguages(allRepos).slice(0, 8);

const repos = allRepos
  .slice()
  .sort((a: any, b: any) => new Date(b.pushed_at ?? 0).getTime() - new Date(a.pushed_at ?? 0).getTime())
  .slice(0, 24);

const repoLanguages = [...new Set(repos.map((r: any) => r.language).filter(Boolean))] as string[];

// Map organization logins to friendly display names if available
const orgDisplayNames: Record<string, string> = Object.fromEntries(
  SITE.orgs.map((o) => [o.login, o.label])
);

const getOrgLabel = (login: string) => orgDisplayNames[login] || login;

const repoOwners = [
  ...new Set(
    repos.map((r: any) => {
      const [owner] = (r.full_name ?? `${GITHUB_USERNAME}/${r.name}`).split("/");
      return owner;
    })
  ),
].sort();

function timeAgo(dateStr: string): string {
  const diffMs = Date.now() - new Date(dateStr).getTime();
  const days = Math.floor(diffMs / 86400000);
  if (days < 1) return "today";
  if (days === 1) return "yesterday";
  if (days < 30) return `${days}d ago`;
  const months = Math.floor(days / 30);
  if (months < 12) return `${months}mo ago`;
  return `${Math.floor(months / 12)}y ago`;
}

const fromSnapshot = usedSnapshot();
---

<Layout title="Repositories, live from GitHub" description="Repositories, organisations, languages and recent activity pulled from GitHub at build time.">

  <div class="wrap page open-source-page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Dev</a> / Repositories</nav>
    <header class="page-head">
      <p class="sl">Repositories</p>
      <h1>Code, live from GitHub</h1>
      <p class="lede">
        Profile, organisations, activity, repositories, and tech stack — all
        pulled directly from GitHub at build time. For the thinking behind what is
        public and why, read <a href="/open-source/">my approach to open source</a>.
      </p>
      {fromSnapshot && (
        <p class="notice" role="status">
          GitHub's live API was not reachable for this build, so this page shows a saved snapshot
          ({snapshotDate.slice(0, 10)}). Organisation repositories and recent activity need the live feed.
        </p>
      )}
    </header>

    <section class="block">
      {profile ? (
        <div class="dev-hero">
          <img class="dev-avatar" src={profile.avatar_url} alt={profile.name ?? GITHUB_USERNAME} loading="lazy" />
          <div>
            <p class="dev-name">{profile.name ?? GITHUB_USERNAME}</p>
            {profile.bio && <p class="dev-bio">{profile.bio}</p>}
            <div class="dev-badges">
              <a href={profile.html_url} target="_blank" rel="noopener noreferrer">
                <img src={`https://img.shields.io/badge/-%40${GITHUB_USERNAME}-141B29?style=flat-square&logo=github&logoColor=EDEAE3`} alt="GitHub profile" />
              </a>
              <img src={`https://img.shields.io/github/followers/${GITHUB_USERNAME}?style=flat-square&label=followers&color=00C2A8&labelColor=141B29`} alt="GitHub followers" />
              <img src={`https://img.shields.io/badge/public_repos-${profile.public_repos ?? 0}-141B29?style=flat-square&labelColor=141B29&color=A78BFA`} alt="Public repos" />
              <img src={`https://img.shields.io/badge/repos_shown-${repos.length}-141B29?style=flat-square&labelColor=141B29&color=F5A623`} alt="Repos shown here" />
            </div>
          </div>
        </div>
      ) : (
        <p class="empty-state">
          GitHub's API is currently unavailable from this build.
        </p>
      )}
    </section>

    {orgs.length > 0 && (
      <section class="block">
        <p class="tlbl">Organisations</p>
        <div class="org-grid">
          {orgs.map((org: any) => (
            <a class="org-card" href={org.html_url} target="_blank" rel="noopener noreferrer">
              <img class="org-avatar" src={org.avatar_url} alt="" loading="lazy" />
              <div>
                <p class="org-name">{org.login}</p>
                {typeof org.public_repos === "number" && <p class="org-meta">{org.public_repos} public repos</p>}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {languages.length > 0 && (
      <section class="block">
        <p class="tlbl">Languages across repos</p>
        <div class="lang-list">
          {languages.map((lang) => (
            <div class="lang-row">
              <span class="lang-name">
                <span class="lang-dot" style={`background:${getLanguageColor(lang.name)}`}></span>
                {lang.name}
              </span>
              <div class="lang-track">
                <div class="lang-fill" style={`width:${lang.pct}%;background:${getLanguageColor(lang.name)}`}></div>
              </div>
              <span class="lang-pct">{lang.pct}%</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="block">
      <p class="tlbl">Repositories, by last commit</p>

      {/* Filter Controls */}
      <div class="filters-container">
        <div class="filter-group">
          <span class="filter-label">Organisation / Owner</span>
          <div class="filters" id="org-filters">
            <button class="filter-btn active" data-filter-org="all">All</button>
            <button class="filter-btn" data-filter-org={GITHUB_USERNAME}>Personal</button>
            {repoOwners.filter(owner => owner !== GITHUB_USERNAME).map((owner) => (
              <button class="filter-btn" data-filter-org={owner}>
                {getOrgLabel(owner)}
              </button>
            ))}
          </div>
        </div>

        {repoLanguages.length > 0 && (
          <div class="filter-group">
            <span class="filter-label">Language</span>
            <div class="filters" id="lang-filters">
              <button class="filter-btn active" data-filter-lang="all">All</button>
              {repoLanguages.map((lang) => (
                <button class="filter-btn" data-filter-lang={lang}>
                  <span class="lang-dot" style={`background:${getLanguageColor(lang)}`}></span>
                  {lang}
                </button>
              ))}
            </div>
          </div>
        )}
      </div>

      {repos.length ? (
        <div class="repo-grid" id="repo-grid">
          {repos.map((repo: any) => {
            const [owner, name] = (repo.full_name ?? `${GITHUB_USERNAME}/${repo.name}`).split("/");
            const isOrg = owner !== GITHUB_USERNAME;
            return (
              <article 
                class="repo-card" 
                data-owner={owner.toLowerCase()}
                data-language={repo.language ? repo.language.toLowerCase() : ""}
              >
                {isOrg && <p class="repo-org">{getOrgLabel(owner)}</p>}
                <a href={repo.html_url} class="repo-name" target="_blank" rel="noopener noreferrer">
                  {repo.name} <span>↗</span>
                </a>
                {repo.description && <p class="repo-desc">{repo.description}</p>}
                {repo.topics?.length > 0 && (
                  <div class="repo-topics">
                    {repo.topics.slice(0, 5).map((topic: string) => (
                      <span class="tag">{topic}</span>
                    ))}
                  </div>
                )}
                <div class="repo-meta-row">
                  {repo.language && (
                    <span class="repo-lang">
                      <span class="lang-dot" style={`background:${getLanguageColor(repo.language)}`}></span>
                      {repo.language}
                    </span>
                  )}
                  <span class="repo-updated">Updated {timeAgo(repo.pushed_at)}</span>
                </div>
                <div class="repo-links">
                  <a href={repo.html_url} target="_blank" rel="noopener noreferrer">View repo ↗</a>
                  {repo.homepage && (
                    <a href={repo.homepage} class="repo-live" target="_blank" rel="noopener noreferrer">Live build ↗</a>
                  )}
                </div>
                <div class="repo-badges">
                  <img src={`https://img.shields.io/github/stars/${owner}/${name}?style=flat-square&labelColor=141B29&color=F5A623`} alt="Stars" />
                  <img src={`https://img.shields.io/github/last-commit/${owner}/${name}?style=flat-square&labelColor=141B29&color=00C2A8`} alt="Last commit" />
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <p class="empty-state">No repos came back from GitHub for this build.</p>
      )}

      <a href={`https://github.com/${GITHUB_USERNAME}?tab=repositories`} class="gh-cta" target="_blank" rel="noopener noreferrer">
        All repositories on GitHub ↗
      </a>
    </section>

    <section class="block">
      <p class="tlbl">Recent activity</p>
      {activity.length ? (
        <div class="activity-list">
          {activity.map((event) => (
            <div class="activity-row">
              <a href={event.url} target="_blank" rel="noopener noreferrer">{event.summary}</a>
              <span class="activity-date">{timeAgo(event.date)}</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="empty-state">No recent public activity came back from GitHub for this build.</p>
      )}

      <div class="activity-graph">
        <img src={`https://ghchart.rshah.org/00C2A8/${GITHUB_USERNAME}`} alt={`${GITHUB_USERNAME}'s GitHub contribution graph`} loading="lazy" />
      </div>
    </section>
  </div>
</Layout>

<script>
  const orgButtons = document.querySelectorAll('#org-filters .filter-btn');
  const langButtons = document.querySelectorAll('#lang-filters .filter-btn');
  const repoCards = document.querySelectorAll<HTMLElement>('#repo-grid .repo-card');

  let activeOrg = 'all';
  let activeLang = 'all';

  function filterRepos() {
    repoCards.forEach((card) => {
      const cardOwner = card.dataset.owner || '';
      const cardLang = card.dataset.language || '';

      const matchesOrg = activeOrg === 'all' || cardOwner === activeOrg.toLowerCase();
      const matchesLang = activeLang === 'all' || cardLang === activeLang.toLowerCase();

      if (matchesOrg && matchesLang) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  }

  orgButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      orgButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeOrg = btn.getAttribute('data-filter-org') || 'all';
      filterRepos();
    });
  });

  langButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      langButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeLang = btn.getAttribute('data-filter-lang') || 'all';
      filterRepos();
    });
  });
</script>

<style>
  .filters-container {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .filter-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.7;
  }
</style>